# Every target/, not only the workspace root's: a nested
# crates/*/target/ escaped `/target` and a test's data dir landed in the
# index, setup code and all.
target/
node_modules/
dist/
*.sqlite
*.sqlite-*
.env
.DS_Store
/overmind-data
# What `docker compose up` creates beside the compose file (ADR-0047): the
# instance's own data. Running the installer's file from a checkout must not
# put somebody's database in the index — the `/target` lesson, which covered
# only the workspace root.
/data/
/agent/
